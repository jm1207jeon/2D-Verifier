<Window x:Class="ZebraScannerSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UDI Capture_ver.1" Height="880" Width="1400"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown">
    <DockPanel>
        <!-- ===================== 상태바 ===================== -->
        <StatusBar DockPanel.Dock="Bottom" Height="30">
            <StatusBarItem>
                <TextBlock x:Name="ScannerStatusText" Text="스캐너: 검색 중..." FontWeight="Bold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="StatusText" Text="준비"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar x:Name="ProgressBarMain" Width="180" Height="14" Margin="0,0,8,0"/>
                    <TextBlock x:Name="BufferText" Text="대기" MinWidth="70"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">

            <!-- ===================== TAB 1 : 일반 스캔 ===================== -->
            <TabItem Header="  일반 스캔  ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="390"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌측 메인 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="동작 모드">
                            <WrapPanel>
                                <RadioButton x:Name="ModeBarcodeOnly" Content="바코드 리딩" Margin="4,4,14,4"
                                             IsChecked="True" Checked="Mode_Changed" VerticalAlignment="Center"/>
                                <RadioButton x:Name="ModeBarcodeImage" Content="바코드 리딩 + 이미지 캡처" Margin="4,4,14,4"
                                             Checked="Mode_Changed" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ForceScanCheck" Margin="4,4,14,4" VerticalAlignment="Center"
                                          Foreground="#FFB03A2E" FontWeight="Bold"
                                          Content="강제 스캔 (F9): 트리거=촬영"
                                          Checked="ForceScan_Toggled" Unchecked="ForceScan_Toggled"
                                          ToolTip="켜면 트리거를 당길 때마다 사진을 촬영해 소프트웨어로 바코드를 인식하고 이미지를 저장합니다."/>
                                <CheckBox x:Name="DupIgnoreCheck" Margin="0,4,14,4" VerticalAlignment="Center"
                                          Content="중복값 무시" IsChecked="True"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                                          ToolTip="이미 스캔한 값은 화면에 표시(하이라이트)만 하고 키보드 입력은 하지 않습니다."/>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="바코드 리딩 값">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Border Background="#FFFDF6E3" BorderBrush="#FFBBB69A" BorderThickness="1" MinHeight="44" Padding="4,2">
                                        <TextBlock x:Name="BarcodeText" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </Border>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock Text="HID 키보드 입력(HID 모드 시 여기에 스캔): " VerticalAlignment="Center"/>
                                        <TextBox x:Name="HidInputBox" Width="260" HorizontalAlignment="Left"
                                                 KeyDown="HidInputBox_KeyDown"
                                                 ToolTip="스캐너가 HID 키보드 모드일 때 이 칸에 포커스를 두고 스캔하면 동일하게 처리됩니다 (Enter 종료 문자 필요)"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock x:Name="SymbologyText" Text="-" FontSize="14" FontWeight="Bold"
                                               Foreground="#FF1A5276" HorizontalAlignment="Center"/>
                                    <Button Content="지우기" Click="ClearScan_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="캡처 이미지">
                            <Grid x:Name="ImageHost" Background="#FF1E1E1E">
                                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                                <TextBlock x:Name="NoImageText" Text="이미지 없음 - '바코드 리딩 + 이미지 캡처' 모드 또는 강제 스캔에서 트리거를 당기면 촬영됩니다"
                                           Foreground="#FF9E9E9E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- 우측 설정 + 실시간 목록 -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="이미지 저장 설정">
                            <StackPanel>
                                <TextBlock Text="저장 경로 (재실행 시에도 유지됩니다)"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="찾아보기" Click="BrowseDir_Click"/>
                                    <TextBox x:Name="SaveDirText" VerticalAlignment="Center" TextChanged="Setting_TextChanged"/>
                                </DockPanel>
                                <CheckBox x:Name="SaveDateFolderCheck" Content="날짜 폴더로 저장 (YYYY-MM-DD)" Margin="0,8,0,0"
                                          IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"
                                          ToolTip="지정 경로 안에 오늘 날짜 폴더를 자동 생성해 그 안에 저장합니다"/>
                                <CheckBox x:Name="SaveLotFolderCheck" Content="LOT 폴더로 저장" Margin="0,4,0,0"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                                          ToolTip="UDI에서 추출한 LOT명 폴더를 자동 생성해 그 안에 저장합니다 (날짜 폴더와 함께 켜면 날짜/LOT 순서로 중첩)"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="UDI 데이터">
                            <DataGrid x:Name="FieldsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" CanUserAddRows="False"
                                      Height="202" RowHeight="24" FontSize="13"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="#FFDDDDDD" VerticalGridLinesBrush="#FFDDDDDD"
                                      BorderBrush="#FFDDDDDD" RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="항목" Binding="{Binding Name}" Width="90"/>
                                    <DataGridTextColumn Header="값" Binding="{Binding Value}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="실시간 목록 (같은 LOT끼리 묶음 표시)">
                            <DataGrid x:Name="ScanListGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" CanUserAddRows="False"
                                      RowHeight="24" FontSize="13"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="#FFDDDDDD" VerticalGridLinesBrush="#FFDDDDDD"
                                      BorderBrush="#FFDDDDDD" RowHeaderWidth="0">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="{Binding GroupBrush}"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="LOT" Binding="{Binding Lot}" Width="95"/>
                                    <DataGridTextColumn Header="EXP" Binding="{Binding Exp}" Width="85"/>
                                    <DataGridTextColumn Header="PN" Binding="{Binding Pn}" Width="*"/>
                                    <DataGridTextColumn Header="SN" Binding="{Binding Sn}" Width="45">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="0,0,6,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== TAB 2 : Multi / Continuous ===================== -->
            <TabItem Header="  멀티 스캔  ">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0">
                        <Button Content="목록 지우기" Click="MultiClear_Click"/>
                        <Button Content="CSV 내보내기" Click="MultiExport_Click"/>
                        <CheckBox x:Name="MultiSaveImageCheck" Content="사진 저장 (판독 시마다 자동 저장)"
                                  VerticalAlignment="Center" Margin="16,0,0,0"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  ToolTip="체크하면 판독할 때마다 같은 위치를 촬영해 이미지 저장 경로에 자동 저장합니다 (화면 표시 없음)"/>
                    </WrapPanel>

                    <DockPanel Grid.Row="1" Margin="4,4">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="BigCountText" Text="0" FontSize="56" FontWeight="Bold"
                                       Foreground="#FFE67E00" VerticalAlignment="Center"/>
                            <TextBlock Text="고유 판독 수" FontSize="14" FontWeight="Bold" Foreground="#FFE67E00"
                                       VerticalAlignment="Bottom" Margin="8,0,24,10"/>
                            <TextBlock Text="총 읽음: " VerticalAlignment="Center"/>
                            <TextBlock x:Name="MultiTotalText" Text="0" FontWeight="Bold" MinWidth="50" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="※ 이 탭에 들어오면 자동으로 준비됩니다. 트리거를 당길 때마다 1회 판독, 중복은 횟수만 증가(무음), 신규만 비프."
                                   Foreground="Gray" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>

                    <GroupBox Grid.Row="2" Header="판독 목록 (중복 제외, 응용식별자별 분리)">
                        <DataGrid x:Name="MultiGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" FontSize="13"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#FFDDDDDD" VerticalGridLinesBrush="#FFDDDDDD"
                                  BorderBrush="#FFDDDDDD" RowHeaderWidth="0" RowHeight="24">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No." Binding="{Binding No}" Width="44">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="시간" Binding="{Binding TimeText}" Width="80"/>
                                <DataGridTextColumn Header="GTIN" Binding="{Binding Gtin}" Width="130"/>
                                <DataGridTextColumn Header="LOT" Binding="{Binding Lot}" Width="100"/>
                                <DataGridTextColumn Header="MFG" Binding="{Binding Mfg}" Width="95"/>
                                <DataGridTextColumn Header="EXP" Binding="{Binding Exp}" Width="95"/>
                                <DataGridTextColumn Header="PN" Binding="{Binding Pn}" Width="110"/>
                                <DataGridTextColumn Header="SN" Binding="{Binding Sn}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="UPN" Binding="{Binding Upn}" Width="120"/>
                                <DataGridTextColumn Header="원본" Binding="{Binding Raw}" Width="*"/>
                                <DataGridTextColumn Header="횟수" Binding="{Binding Count}" Width="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
