<Window x:Class="ZebraScannerSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UDI Capture_ver.1" Height="880" Width="1400"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown"
        PreviewTextInput="Window_PreviewTextInput">
    <DockPanel>
        <!-- ===================== 상태바 ===================== -->
        <StatusBar DockPanel.Dock="Bottom" Height="30">
            <StatusBarItem>
                <TextBlock x:Name="ScannerStatusText" Text="스캐너: 검색 중..." FontWeight="Bold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="StatusText" Text="준비"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar x:Name="ProgressBarMain" Width="180" Height="14" Margin="0,0,8,0"/>
                    <TextBlock x:Name="BufferText" Text="대기" MinWidth="70"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">

            <!-- ===================== TAB 1 : 일반 스캔 ===================== -->
            <TabItem Header="  일반 스캔  ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="390"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌측 메인 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="동작 모드">
                            <WrapPanel>
                                <RadioButton x:Name="ModeBarcodeOnly" Content="바코드 리딩" Margin="4,4,14,4"
                                             IsChecked="True" Checked="Mode_Changed" VerticalAlignment="Center"/>
                                <RadioButton x:Name="ModeBarcodeImage" Content="바코드 리딩 + 이미지 캡처" Margin="4,4,14,4"
                                             Checked="Mode_Changed" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ForceScanCheck" Margin="4,4,14,4" VerticalAlignment="Center"
                                          Foreground="#FFB03A2E" FontWeight="Bold"
                                          Content="강제 스캔 (F9): 트리거=촬영"
                                          Checked="ForceScan_Toggled" Unchecked="ForceScan_Toggled"
                                          ToolTip="켜면 트리거를 당길 때마다 사진을 촬영해 소프트웨어로 바코드를 인식하고 이미지를 저장합니다."/>
                                <CheckBox x:Name="DupIgnoreCheck" Margin="0,4,14,4" VerticalAlignment="Center"
                                          Content="중복값 무시" IsChecked="True"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                                          ToolTip="이미 스캔한 값은 화면에 표시(하이라이트)만 하고 키보드 입력은 하지 않습니다."/>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="바코드 리딩 값">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Border Background="#FFFDF6E3" BorderBrush="#FFBBB69A" BorderThickness="1" MinHeight="44" Padding="4,2">
                                        <TextBlock x:Name="BarcodeText" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </Border>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock Text="키보드 스캐너 입력: " VerticalAlignment="Center"/>
                                        <TextBox x:Name="HidInputBox" Width="260" HorizontalAlignment="Left"
                                                 KeyDown="HidInputBox_KeyDown"
                                                 ToolTip="일반(키보드 방식) 스캐너는 이 창이 활성화되어 있으면 포커스 없이도 자동 인식됩니다. 자동 인식이 안 되는 스캐너만 이 칸에 포커스를 두고 스캔하세요 (Enter 종료 문자 필요)"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock x:Name="SymbologyText" Text="-" FontSize="14" FontWeight="Bold"
                                               Foreground="#FF1A5276" HorizontalAlignment="Center"/>
                                    <Button Content="지우기" Click="ClearScan_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="캡처 이미지">
                            <Grid x:Name="ImageHost" Background="#FF1E1E1E">
                                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                                <TextBlock x:Name="NoImageText" Text="이미지 없음 - '바코드 리딩 + 이미지 캡처' 모드 또는 강제 스캔에서 트리거를 당기면 촬영됩니다"
                                           Foreground="#FF9E9E9E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- 우측 설정 + 실시간 목록 -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="이미지 저장 설정">
                            <StackPanel>
                                <TextBlock Text="저장 경로 (재실행 시에도 유지됩니다)"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="찾아보기" Click="BrowseDir_Click"/>
                                    <TextBox x:Name="SaveDirText" VerticalAlignment="Center" TextChanged="Setting_TextChanged"/>
                                </DockPanel>
                                <CheckBox x:Name="SaveDateFolderCheck" Content="날짜 폴더로 저장 (YYYY-MM-DD)" Margin="0,8,0,0"
                                          IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"
                                          ToolTip="지정 경로 안에 오늘 날짜 폴더를 자동 생성해 그 안에 저장합니다"/>
                                <CheckBox x:Name="SaveLotFolderCheck" Content="LOT 폴더로 저장" Margin="0,4,0,0"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                                          ToolTip="UDI에서 추출한 LOT명 폴더를 자동 생성해 그 안에 저장합니다 (날짜 폴더와 함께 켜면 날짜/LOT 순서로 중첩)"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="UDI 데이터">
                            <DataGrid x:Name="FieldsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" CanUserAddRows="False"
                                      Height="202" RowHeight="24" FontSize="13"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="#FFDDDDDD" VerticalGridLinesBrush="#FFDDDDDD"
                                      BorderBrush="#FFDDDDDD" RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="항목" Binding="{Binding Name}" Width="90"/>
                                    <DataGridTextColumn Header="값" Binding="{Binding Value}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="실시간 목록 (같은 LOT끼리 묶음 표시)">
                            <DataGrid x:Name="ScanListGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" CanUserAddRows="False"
                                      RowHeight="24" FontSize="13"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="#FFDDDDDD" VerticalGridLinesBrush="#FFDDDDDD"
                                      BorderBrush="#FFDDDDDD" RowHeaderWidth="0">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="{Binding GroupBrush}"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="LOT" Binding="{Binding Lot}" Width="95"/>
                                    <DataGridTextColumn Header="EXP" Binding="{Binding Exp}" Width="85"/>
                                    <DataGridTextColumn Header="PN" Binding="{Binding Pn}" Width="*"/>
                                    <DataGridTextColumn Header="SN" Binding="{Binding Sn}" Width="45">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="0,0,6,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== TAB 2 : Multi / Continuous ===================== -->
            <TabItem Header="  멀티 스캔  ">
                <Grid Margin="4">
                    <Grid.Resources>
                        <!-- 우측 정렬 셀 (숫자 컬럼용) -->
                        <Style x:Key="RightCell" TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,6,0"/>
                        </Style>
                        <!-- MFG 셀: EXP에서 역산된 값이면 파란색으로 구분 표시 -->
                        <Style x:Key="MfgCell" TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MfgComputed}" Value="True">
                                    <Setter Property="Foreground" Value="#FF1565C0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0">
                        <Button Content="목록 지우기" Click="MultiClear_Click"/>
                        <Button Content="CSV 내보내기" Click="MultiExport_Click"
                                ToolTip="현재 보기 모드(세로/가로)와 정렬 순서 그대로 내보냅니다"/>
                        <CheckBox x:Name="MultiSaveImageCheck" Content="사진 저장 (판독 시마다 자동 저장)"
                                  VerticalAlignment="Center" Margin="16,0,0,0"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  ToolTip="체크하면 판독할 때마다 같은 위치를 촬영해 이미지 저장 경로에 자동 저장합니다 (화면 표시 없음)"/>
                        <Separator Width="16" Visibility="Hidden"/>
                        <TextBlock Text="보기:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <RadioButton x:Name="MultiViewVertical" Content="세로 모드" IsChecked="True"
                                     VerticalAlignment="Center" Margin="0,0,10,0" Checked="MultiView_Changed"
                                     ToolTip="스캔 1건 = 1행 (고유 코드별, 중복은 Count 증가)"/>
                        <RadioButton x:Name="MultiViewHorizontal" Content="가로 모드"
                                     VerticalAlignment="Center" Checked="MultiView_Changed"
                                     ToolTip="LOT당 1행, 시리얼은 SN 셀에 콤마로 누적 (최종 정리용)"/>
                    </WrapPanel>

                    <DockPanel Grid.Row="1" Margin="4,4">
                        <!-- 우측 상단: 실시간 스캔 속도 (최근 스캔 간격 평균) -->
                        <TextBlock DockPanel.Dock="Right" x:Name="ScanRateText" Text="스캔 속도 0 Unit/Min"
                                   FontSize="20" FontWeight="Bold" Foreground="#FF666666"
                                   VerticalAlignment="Top" Margin="0,4,8,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="BigCountText" Text="0" FontSize="56" FontWeight="Bold"
                                       Foreground="#FFE67E00" VerticalAlignment="Center"/>
                            <TextBlock Text="고유 판독 수" FontSize="14" FontWeight="Bold" Foreground="#FFE67E00"
                                       VerticalAlignment="Bottom" Margin="8,0,28,10"/>
                            <TextBlock x:Name="BatchCountText" Text="0" FontSize="56" FontWeight="Bold"
                                       Foreground="#FF1A6FB5" VerticalAlignment="Center"/>
                            <TextBlock Text="총 배치 수" FontSize="14" FontWeight="Bold" Foreground="#FF1A6FB5"
                                       VerticalAlignment="Bottom" Margin="8,0,28,10"
                                       ToolTip="중복 없는 고유 LOT 개수"/>
                            <TextBlock Text="총 읽음: " VerticalAlignment="Center"/>
                            <TextBlock x:Name="MultiTotalText" Text="0" FontWeight="Bold" MinWidth="50" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <GroupBox Grid.Row="2" Header="판독 목록 (헤더 클릭: 오름차순 → 내림차순 → 기본, 클릭 순서대로 다중 정렬)">
                        <Grid>
                            <!-- 세로 모드: 스캔 1건 = 1행 -->
                            <DataGrid x:Name="MultiGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserReorderColumns="False" FontSize="13"
                                      GridLinesVisibility="All" Sorting="MultiGrid_Sorting"
                                      HorizontalGridLinesBrush="#FFDDDDDD" VerticalGridLinesBrush="#FFDDDDDD"
                                      BorderBrush="#FFDDDDDD" RowHeaderWidth="0" RowHeight="24">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="{Binding GroupBrush}"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No." Binding="{Binding No}" SortMemberPath="No"
                                                        Width="44" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" SortMemberPath="TimeText" Width="72"/>
                                    <DataGridTextColumn Header="UDI" Binding="{Binding Raw}" SortMemberPath="Raw" Width="450"/>
                                    <DataGridTextColumn Header="GTIN" Binding="{Binding Gtin}" SortMemberPath="Gtin" Width="120"/>
                                    <DataGridTextColumn Header="PN" Binding="{Binding Pn}" SortMemberPath="Pn" Width="85"/>
                                    <DataGridTextColumn Header="LOT" Binding="{Binding Lot}" SortMemberPath="Lot" Width="85"/>
                                    <DataGridTextColumn Header="SN" Binding="{Binding Sn}" SortMemberPath="Sn"
                                                        Width="48" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="MFG" Binding="{Binding Mfg}" SortMemberPath="Mfg" Width="88"
                                                        ElementStyle="{StaticResource MfgCell}"/>
                                    <DataGridTextColumn Header="EXP" Binding="{Binding Exp}" SortMemberPath="Exp" Width="88"/>
                                    <DataGridTextColumn Header="UPN" Binding="{Binding Upn}" SortMemberPath="Upn" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 가로 모드: LOT당 1행, SN은 콤마 누적 (최대 15개 고려해 SN 열을 넓게) -->
                            <DataGrid x:Name="MultiLotGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserReorderColumns="False" FontSize="13"
                                      GridLinesVisibility="All" Sorting="MultiGrid_Sorting" Visibility="Collapsed"
                                      HorizontalGridLinesBrush="#FFDDDDDD" VerticalGridLinesBrush="#FFDDDDDD"
                                      BorderBrush="#FFDDDDDD" RowHeaderWidth="0" RowHeight="24">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No." Binding="{Binding No}" SortMemberPath="No"
                                                        Width="44" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" SortMemberPath="TimeText" Width="72"/>
                                    <DataGridTextColumn Header="UDI" Binding="{Binding Udi}" SortMemberPath="Udi" Width="450"/>
                                    <DataGridTextColumn Header="GTIN" Binding="{Binding Gtin}" SortMemberPath="Gtin" Width="120"/>
                                    <DataGridTextColumn Header="PN" Binding="{Binding Pn}" SortMemberPath="Pn" Width="85"/>
                                    <DataGridTextColumn Header="LOT" Binding="{Binding Lot}" SortMemberPath="Lot" Width="85"/>
                                    <DataGridTemplateColumn x:Name="MultiLotSnColumn" Header="SN"
                                                            CanUserSort="False" Width="*" MinWidth="350">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- 1~15 고정 위치 슬롯: 스캔 전 연회색, 스캔되면 검정 굵게 -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ItemsControl ItemsSource="{Binding Slots}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Num}" Width="22" TextAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#FFC8C8C8"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Scanned}" Value="True">
                                                                                    <Setter Property="Foreground" Value="Black"/>
                                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- 1~15 범위 밖 시리얼은 우측에 별도 표기 -->
                                                    <TextBlock Text="{Binding SnExtra}" Margin="6,0,0,0" FontWeight="Bold"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="QTY" Binding="{Binding Qty}" SortMemberPath="Qty"
                                                        Width="48" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="MFG" Binding="{Binding Mfg}" SortMemberPath="Mfg" Width="88"
                                                        ElementStyle="{StaticResource MfgCell}"/>
                                    <DataGridTextColumn Header="EXP" Binding="{Binding Exp}" SortMemberPath="Exp" Width="88"/>
                                    <DataGridTextColumn Header="UPN" Binding="{Binding Upn}" SortMemberPath="Upn" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
