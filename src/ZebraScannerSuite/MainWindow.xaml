<Window x:Class="ZebraScannerSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Zebra DS9908 Scanner Suite" Height="880" Width="1400"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown">
    <Window.Resources>
        <x:Array x:Key="RuleTypes" Type="sys:String">
            <sys:String>GS1</sys:String>
            <sys:String>REGEX</sys:String>
            <sys:String>SUBSTR</sys:String>
        </x:Array>
    </Window.Resources>

    <DockPanel>
        <!-- ===================== 상태바 ===================== -->
        <StatusBar DockPanel.Dock="Bottom" Height="30">
            <StatusBarItem>
                <TextBlock x:Name="ScannerStatusText" Text="스캐너: 검색 중..." FontWeight="Bold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="StatusText" Text="준비"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar x:Name="ProgressBarMain" Width="180" Height="14" Margin="0,0,8,0"/>
                    <TextBlock x:Name="BufferText" Text="대기" MinWidth="70"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">

            <!-- ===================== TAB 1 : 일반 스캔 ===================== -->
            <TabItem Header="  일반 스캔  ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="390"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌측 메인 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="185"/>
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="동작 모드 / 스캐너 연결">
                            <WrapPanel>
                                <RadioButton x:Name="ModeBarcodeOnly" Content="① 바코드만 리딩" Margin="4,4,14,4"
                                             IsChecked="True" Checked="Mode_Changed" VerticalAlignment="Center"/>
                                <RadioButton x:Name="ModeBarcodeImage" Content="② 바코드 + 이미지 캡처" Margin="4,4,14,4"
                                             Checked="Mode_Changed" VerticalAlignment="Center"/>
                                <RadioButton x:Name="ModeBarcodeImageOcr" Content="③ 바코드 + 이미지 + OCR 입력" Margin="4,4,14,4"
                                             Checked="Mode_Changed" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ForceScanCheck" Margin="4,4,6,4" VerticalAlignment="Center"
                                          Foreground="#FFB03A2E" FontWeight="Bold"
                                          Content="강제 스캔 (F9): 트리거=촬영"
                                          Checked="ForceScan_Toggled" Unchecked="ForceScan_Toggled"
                                          ToolTip="켜면 트리거를 당길 때마다 사진을 촬영해 소프트웨어로 바코드를 인식하고 이미지를 저장합니다."/>
                                <CheckBox x:Name="ForceOcrEnableCheck" Margin="0,4,14,4" VerticalAlignment="Center"
                                          Content="+ OCR 수행"
                                          IsEnabled="{Binding IsChecked, ElementName=ForceScanCheck}"
                                          ToolTip="강제 스캔 시 바코드가 없으면 강제 OCR 규칙(Lot+SN 등)으로 텍스트 값을 추출합니다. 강제 스캔이 꺼져 있으면 사용할 수 없습니다."/>
                                <Separator Width="12" Visibility="Hidden"/>
                                <TextBlock Text="호스트 모드:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <ComboBox x:Name="HostModeCombo" Width="215" VerticalAlignment="Center"/>
                                <CheckBox x:Name="HostModePermanent" Content="영구 적용" VerticalAlignment="Center" Margin="6,0"/>
                                <Button Content="모드 전환" Click="SwitchHostMode_Click"/>
                                <Button Content="스캐너 새로고침" Click="RefreshScanners_Click"/>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="바코드 리딩 값">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBox x:Name="BarcodeText" IsReadOnly="True" FontSize="24" FontWeight="Bold"
                                             TextWrapping="Wrap" MinHeight="44" Background="#FFFDF6E3"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock Text="HID 키보드 입력(HID 모드 시 여기에 스캔): " VerticalAlignment="Center"/>
                                        <TextBox x:Name="HidInputBox" Width="260" HorizontalAlignment="Left"
                                                 KeyDown="HidInputBox_KeyDown"
                                                 ToolTip="스캐너가 HID 키보드 모드일 때 이 칸에 포커스를 두고 스캔하면 동일하게 처리됩니다 (Enter 종료 문자 필요)"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock x:Name="SymbologyText" Text="-" FontSize="14" FontWeight="Bold"
                                               Foreground="#FF1A5276" HorizontalAlignment="Center"/>
                                    <Button Content="지우기" Click="ClearScan_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="캡처 이미지 (마우스 드래그로 OCR 영역 선택)">
                            <Grid x:Name="ImageHost" Background="#FF1E1E1E"
                                  MouseLeftButtonDown="ImageHost_MouseDown"
                                  MouseMove="ImageHost_MouseMove"
                                  MouseLeftButtonUp="ImageHost_MouseUp">
                                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                                <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                                    <Rectangle x:Name="SelectionRect" Stroke="OrangeRed" StrokeThickness="2"
                                               StrokeDashArray="4 2" Fill="#33FF4500" Visibility="Collapsed"/>
                                </Canvas>
                                <TextBlock x:Name="NoImageText" Text="이미지 없음 - ②/③ 모드에서 트리거를 당기면 촬영됩니다"
                                           Foreground="#FF9E9E9E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="3" Header="OCR (사전 설정 패턴 일치 문자만 채택)">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="선택 영역 OCR" Click="OcrRegion_Click"/>
                                <Button DockPanel.Dock="Left" Content="전체 이미지 OCR" Click="OcrFull_Click"/>
                                <TextBlock DockPanel.Dock="Left" Text="  OCR 값: " VerticalAlignment="Center"/>
                                <TextBox x:Name="OcrResultText" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </GroupBox>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <GroupBox Grid.Column="0" Header="추출 필드 (AI/위치/정규식 규칙 적용)">
                                <DataGrid x:Name="FieldsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="항목" Binding="{Binding Name}" Width="130"/>
                                        <DataGridTextColumn Header="값" Binding="{Binding Value}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="최근 스캔">
                                <ListView x:Name="HistoryList">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="시간" Width="70" DisplayMemberBinding="{Binding TimeText}"/>
                                            <GridViewColumn Header="바코드" Width="200" DisplayMemberBinding="{Binding Barcode}"/>
                                            <GridViewColumn Header="OCR" Width="90" DisplayMemberBinding="{Binding OcrValue}"/>
                                            <GridViewColumn Header="이미지 파일" Width="220" DisplayMemberBinding="{Binding ImagePath}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </GroupBox>
                        </Grid>
                    </Grid>

                    <!-- 우측 설정 -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="이미지 저장 설정">
                                <StackPanel>
                                    <TextBlock Text="저장 경로 (재실행 시에도 유지됩니다)"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="찾아보기" Click="BrowseDir_Click"/>
                                        <TextBox x:Name="SaveDirText" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="파일명 규칙" Margin="0,8,0,0"/>
                                    <TextBox x:Name="FileRuleText" TextChanged="FileRuleText_TextChanged"/>
                                    <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                               Text="토큰: {DATE:yyyyMMdd} {TIME:HHmmss} {BARCODE} {SYMBOLOGY} {SEQ:3} {OCR}  /  ### = {SEQ:3}"/>
                                    <TextBlock x:Name="FileRuleExample" FontSize="11" Foreground="#FF1A5276" TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="장치 설정">
                                <StackPanel>
                                    <CheckBox x:Name="DisableKbdEmuCheck"
                                              Content="키보드 에뮬레이터 끄기 (스캔 시 Caps Lock 토글 방지)"
                                              Checked="KbdEmu_Toggled" Unchecked="KbdEmu_Toggled"/>
                                    <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                               Text="Zebra CoreScanner 드라이버의 HID 키보드 에뮬레이터가 스캔할 때마다 데이터를 키보드로 타이핑하면서 Caps Lock을 켜고 끄는 현상을 방지합니다. 본 프로그램은 SDK로 직접 데이터를 받으므로 에뮬레이터가 필요 없습니다. (해제 시 다시 타이핑 동작)"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="OCR 설정">
                                <StackPanel>
                                    <TextBlock x:Name="OcrEngineText" FontSize="11" Foreground="Gray"/>
                                    <TextBlock Text="허용 패턴 (정규식, 한 줄에 하나) - 일치 문자만 입력" Margin="0,4,0,0"/>
                                    <TextBox x:Name="OcrPatternsText" AcceptsReturn="True" Height="80"
                                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                                    <CheckBox x:Name="CopyClipboardCheck" Content="OCR 결과를 클립보드로 복사 (빠른 입력)" Margin="0,6,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="강제 OCR 규칙 (텍스트 라벨 → 값 변환, 위에서부터 첫 일치 적용)">
                                <StackPanel>
                                    <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                               Text="정규식 캡처 그룹을 출력의 $1,$2로 조합. 예: 'Lot No. 26070124 / SN. 14' → 26070124-14, '26070124-1' → 26070124-1"/>
                                    <DataGrid x:Name="ForceRulesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                              Height="110" HeadersVisibility="Column" FontFamily="Consolas">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="90"/>
                                            <DataGridTextColumn Header="패턴(정규식)" Binding="{Binding Pattern}" Width="*"/>
                                            <DataGridTextColumn Header="출력" Binding="{Binding Output}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="규칙 추가" Click="AddForceRule_Click"/>
                                        <Button Content="선택 삭제" Click="DelForceRule_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="데이터 추출 규칙">
                                <StackPanel>
                                    <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                               Text="GS1: 파라미터1=응용식별자(예 01,10,17) / REGEX: 파라미터1=정규식 / SUBSTR: 파라미터1=시작위치(1부터), 파라미터2=길이"/>
                                    <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                              Height="190" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="80"/>
                                            <DataGridComboBoxColumn Header="유형" SelectedItemBinding="{Binding Type}"
                                                                    ItemsSource="{StaticResource RuleTypes}" Width="70"/>
                                            <DataGridTextColumn Header="파라미터1" Binding="{Binding Param1}" Width="90"/>
                                            <DataGridTextColumn Header="파라미터2" Binding="{Binding Param2}" Width="60"/>
                                            <DataGridCheckBoxColumn Header="날짜변환" Binding="{Binding DateConvert}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="규칙 추가" Click="AddRule_Click"/>
                                        <Button Content="선택 삭제" Click="DelRule_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <Button Content="설정 저장" FontWeight="Bold" Click="SaveSettings_Click" Margin="6"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===================== TAB 2 : Multi / Continuous ===================== -->
            <TabItem Header="  Multi / Continuous  ">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0">
                        <Button x:Name="MultiStartBtn" Content="▶ 시작 (트리거 유지 연속 스캔)" FontWeight="Bold" Click="MultiStart_Click"/>
                        <Button x:Name="MultiStopBtn" Content="■ 정지" IsEnabled="False" Click="MultiStop_Click"/>
                        <CheckBox x:Name="MultiRetriggerCheck" Content="자동 재트리거 (연속 유지)" IsChecked="True"
                                  VerticalAlignment="Center" Margin="10,0"/>
                        <Button Content="목록 지우기" Click="MultiClear_Click"/>
                        <Button Content="CSV 내보내기" Click="MultiExport_Click"/>
                    </WrapPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,6">
                        <TextBlock Text="총 읽음: "/>
                        <TextBlock x:Name="MultiTotalText" Text="0" FontWeight="Bold" MinWidth="50"/>
                        <TextBlock Text="   고유 바코드: "/>
                        <TextBlock x:Name="MultiUniqueText" Text="0" FontWeight="Bold" MinWidth="50"/>
                        <TextBlock Text="   ※ 시야 내 바코드를 트리거 유지 상태로 빠르게 훑으세요. 중복은 자동 제거(횟수 집계)됩니다."
                                   Foreground="Gray"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="MultiGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding No}" Width="50"/>
                            <DataGridTextColumn Header="최초 시간" Binding="{Binding TimeText}" Width="90"/>
                            <DataGridTextColumn Header="심볼로지" Binding="{Binding Symbology}" Width="130"/>
                            <DataGridTextColumn Header="데이터" Binding="{Binding Data}" Width="*"/>
                            <DataGridTextColumn Header="읽은 횟수" Binding="{Binding Count}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
