<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ZebraScannerSuite</RootNamespace>
    <AssemblyName>UDI Capture_ver.1</AssemblyName>
    <ApplicationIcon />
    <Version>1.0.0</Version>
    <Product>UDI Capture_ver.1</Product>
    <AssemblyTitle>UDI Capture_ver.1</AssemblyTitle>
    <Description>UDI Capture - Zebra DS9908 바코드 스캔 / 이미지 캡처</Description>
    <!-- CoreScanner COM은 x86/x64 모두 제공되나, 문제가 있으면 x86으로 고정하세요 -->
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <!--
    Zebra CoreScanner 연동은 Services/CoreScannerInterop.cs 의 수동 COM interop을 사용합니다.
    (COMReference 미사용 → 'dotnet build' 만으로 빌드 가능, 빌드 PC에 Zebra SDK 불필요)
    실행 PC에는 Zebra Scanner SDK for Windows(CoreScanner 드라이버) 설치가 필요합니다.
    다운로드: https://www.zebra.com/us/en/support-downloads/software/developer-tools/scanner-sdk-for-windows.html
  -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.12" />
  </ItemGroup>

</Project>
